# ─── Portal QR — Variables de producción ──────────────────────────────────────
# Copia este archivo como .env en el proceso de build de producción del portal QR.
# NUNCA commitear el .env real.

# URL del backend NestJS (sin trailing slash)
# El portal llama a: ${VITE_API_URL}/public/equipment/:qrCode
VITE_API_URL="https://api.stechnodes.com"

# ─── CHECKLIST DE PRODUCCIÓN ──────────────────────────────────────────────────
# Antes de desplegar el portal QR en producción verificar:
# [ ] VITE_API_URL apunta al backend real (no localhost)
# [ ] El backend tiene PORTAL_ORIGIN configurado con la URL de este portal
# [ ] El portal se sirve en HTTPS
# [ ] Probar manualmente un QR válido, uno inválido, y uno de equipo dado de baja
# [ ] Probar en móvil real (no solo simulador de browser)
