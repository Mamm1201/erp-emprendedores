# ─── ERP Frontend — Variables de producción ───────────────────────────────────
# Copia este archivo como .env en el proceso de build de producción.
# NUNCA commitear el .env real.

# URL del backend NestJS (sin trailing slash)
VITE_API_URL="https://api.stechnodes.com"

# URL base del portal QR público (sin trailing slash)
# CRÍTICO: Este valor se codifica dentro de los QR generados en el ERP.
# Si este valor es incorrecto o apunta a localhost, todas las etiquetas QR impresas
# apuntarán a una URL inaccesible. Verificar ANTES de generar y distribuir etiquetas.
VITE_PORTAL_URL="https://portal.stechnodes.com"

# ─── CHECKLIST DE PRODUCCIÓN ──────────────────────────────────────────────────
# Antes de generar los primeros QR físicos verificar:
# [ ] VITE_PORTAL_URL apunta al portal real (no localhost)
# [ ] VITE_API_URL apunta al backend real (no localhost)
# [ ] Hacer un build de producción (npm run build) con estos valores
# [ ] Generar un QR de prueba y escanear para confirmar que abre el portal correcto
# [ ] No distribuir etiquetas físicas sin completar esta verificación
