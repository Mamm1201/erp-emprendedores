generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  COMMERCIAL
  TECHNICIAN
  BILLING
}

enum ClientType {
  COMPANY
  PERSON
}

enum DocumentType {
  QUOTATION
  WORK_ORDER
  INVOICE
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum WorkOrderStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHECK
  CARD
  OTHER
}

enum ExpenseCategory {
  MATERIALS
  LABOR
  TRANSPORT
  TOOLS
  SUBCONTRACT
  OFFICE
  OTHER
}

// ─── Secuencias comerciales ──────────────────────────────────────────────────

model DocumentSequence {
  id        String       @id @default(cuid())
  docType   DocumentType
  year      Int
  lastValue Int          @default(0)

  @@unique([docType, year])
  @@map("document_sequences")
}

// ─── Usuarios (auditoría; sin módulo auth en MVP) ─────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      UserRole @default(COMMERCIAL)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotationsCreated Quotation[] @relation("QuotationCreatedBy")
  quotationsUpdated Quotation[] @relation("QuotationUpdatedBy")
  workOrdersCreated WorkOrder[] @relation("WorkOrderCreatedBy")
  workOrdersUpdated WorkOrder[] @relation("WorkOrderUpdatedBy")
  workOrdersAssigned WorkOrder[] @relation("WorkOrderAssignedTo")
  invoicesCreated   Invoice[]   @relation("InvoiceCreatedBy")
  paymentsCreated   Payment[]   @relation("PaymentCreatedBy")
  expensesCreated   Expense[]   @relation("ExpenseCreatedBy")

  @@map("users")
}

// ─── Maestros ────────────────────────────────────────────────────────────────

model Client {
  id        String     @id @default(cuid())
  type      ClientType @default(COMPANY)
  legalName String
  tradeName String?
  taxId     String?    @unique
  email     String?
  phone     String?
  notes     String?
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  branches         Branch[]
  quotations       Quotation[]
  workOrders       WorkOrder[]
  invoices         Invoice[]
  maintenancePlans MaintenancePlan[]

  @@index([legalName])
  @@map("clients")
}

model Branch {
  id           String    @id @default(cuid())
  clientId     String
  name         String
  contactName  String?
  contactPhone String?
  email        String?
  address      String?
  city         String?
  department   String?
  notes        String?
  isPrimary    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client           Client            @relation(fields: [clientId], references: [id])
  quotations       Quotation[]
  workOrders       WorkOrder[]
  equipment        Equipment[]
  maintenancePlans MaintenancePlan[]

  @@index([clientId])
  @@index([clientId, name])
  @@map("branches")
}

// ─── Cotización ──────────────────────────────────────────────────────────────

model Quotation {
  id            String          @id @default(cuid())
  number        String          @unique
  clientId      String
  branchId      String?
  status        QuotationStatus @default(DRAFT)
  issueDate     DateTime        @default(now()) @db.Date
  validUntil    DateTime?       @db.Date
  notes         String?
  terms         String?
  subtotal      Decimal         @default(0) @db.Decimal(12, 2)
  discountTotal Decimal         @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal         @default(0) @db.Decimal(12, 2)
  total         Decimal         @default(0) @db.Decimal(12, 2)
  clientLegalName     String?
  clientTaxId         String?
  branchName          String?
  branchAddress       String?
  branchCity          String?
  branchDepartment    String?
  branchContactName   String?
  branchContactPhone  String?
  snapshotAt          DateTime?
  createdById   String?
  updatedById   String?
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  client    Client          @relation(fields: [clientId], references: [id])
  branch    Branch?         @relation(fields: [branchId], references: [id])
  workOrder WorkOrder?
  items     QuotationItem[]
  createdBy User?           @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  updatedBy User?           @relation("QuotationUpdatedBy", fields: [updatedById], references: [id])

  @@index([clientId, status])
  @@index([issueDate])
  @@map("quotations")
}

model QuotationItem {
  id             String   @id @default(cuid())
  quotationId    String
  lineOrder      Int      @default(0)
  description    String
  quantity       Decimal  @db.Decimal(12, 3)
  unitPrice      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  lineSubtotal   Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

// ─── Orden de trabajo ────────────────────────────────────────────────────────

model WorkOrder {
  id            String          @id @default(cuid())
  number        String          @unique
  clientId      String
  branchId      String?
  quotationId   String?         @unique
  status        WorkOrderStatus @default(DRAFT)
  title         String
  description   String?
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  subtotal      Decimal         @default(0) @db.Decimal(12, 2)
  discountTotal Decimal         @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal         @default(0) @db.Decimal(12, 2)
  total         Decimal         @default(0) @db.Decimal(12, 2)
  assignedToId  String?
  createdById   String?
  updatedById   String?
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  client     Client           @relation(fields: [clientId], references: [id])
  branch     Branch?          @relation(fields: [branchId], references: [id])
  quotation  Quotation?       @relation(fields: [quotationId], references: [id])
  items      WorkOrderItem[]
  invoice    Invoice?
  expenses   Expense[]
  assignedTo    User?            @relation("WorkOrderAssignedTo", fields: [assignedToId], references: [id])
  createdBy     User?            @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?            @relation("WorkOrderUpdatedBy", fields: [updatedById], references: [id])
  serviceRecord ServiceRecord?

  @@index([clientId, status])
  @@index([assignedToId])
  @@index([completedAt])
  @@map("work_orders")
}

model WorkOrderItem {
  id             String   @id @default(cuid())
  workOrderId    String
  lineOrder      Int      @default(0)
  description    String
  quantity       Decimal  @db.Decimal(12, 3)
  unitPrice      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  lineSubtotal   Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("work_order_items")
}

// ─── Cuenta de cobro ─────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  workOrderId   String        @unique
  clientId      String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now()) @db.Date
  dueDate       DateTime      @db.Date
  notes         String?
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  voidedAt      DateTime?
  voidReason    String?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workOrder WorkOrder     @relation(fields: [workOrderId], references: [id])
  client    Client        @relation(fields: [clientId], references: [id])
  items     InvoiceItem[]
  payments  Payment[]
  createdBy User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  @@index([clientId, status])
  @@index([dueDate])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  lineOrder      Int      @default(0)
  description    String
  quantity       Decimal  @db.Decimal(12, 3)
  unitPrice      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  lineSubtotal   Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ─── Pagos y gastos ──────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  amount      Decimal       @db.Decimal(12, 2)
  paidAt      DateTime      @default(now())
  method      PaymentMethod @default(TRANSFER)
  reference   String?
  notes       String?
  voidedAt    DateTime?
  voidReason  String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  createdBy User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([invoiceId])
  @@index([paidAt])
  @@map("payments")
}

model Expense {
  id          String          @id @default(cuid())
  workOrderId String?
  category    ExpenseCategory @default(OTHER)
  description String
  amount      Decimal         @db.Decimal(12, 2)
  expenseDate DateTime        @default(now()) @db.Date
  vendorName  String?
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])
  createdBy User?      @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([workOrderId])
  @@index([expenseDate])
  @@index([category])
  @@map("expenses")
}

// ─── Enums CMMS ───────────────────────────────────────────────────────────────

enum EquipmentType {
  NURSE_CALL
  MEDICAL_ALERT
  GENERATOR
  UPS
  ELECTRICAL
  OTHER
}

enum EquipmentStatus {
  ACTIVE
  INACTIVE
  DECOMMISSIONED
}

enum MaintenanceFrequency {
  MONTHLY
  QUARTERLY
  EVERY_4_MONTHS
  BIANNUAL
  ANNUAL
}

enum ChecklistResult {
  OK
  WARNING
  FAIL
  NA
}

// ─── Hoja de vida del equipo ──────────────────────────────────────────────────

model Equipment {
  id           String          @id @default(cuid())
  branchId     String
  type         EquipmentType
  brand        String?
  model        String?
  serialNumber String?
  installDate  DateTime?       @db.Date
  location     String?
  notes        String?
  status       EquipmentStatus @default(ACTIVE)
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  branch         Branch          @relation(fields: [branchId], references: [id])
  serviceRecords ServiceRecord[]

  @@index([branchId])
  @@index([type])
  @@map("equipment")
}

// ─── Plan de mantenimiento preventivo ────────────────────────────────────────

model MaintenancePlan {
  id                String               @id @default(cuid())
  clientId          String
  branchId          String?
  frequency         MaintenanceFrequency
  contractStartDate DateTime             @db.Date
  contractEndDate   DateTime?            @db.Date
  nextVisitDate     DateTime             @db.Date
  isActive          Boolean              @default(true)
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  client Client  @relation(fields: [clientId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([clientId])
  @@index([nextVisitDate])
  @@index([isActive])
  @@map("maintenance_plans")
}

// ─── Acta técnica de la visita ────────────────────────────────────────────────

model ServiceRecord {
  id                  String    @id @default(cuid())
  workOrderId         String    @unique
  equipmentId         String?
  findings            String?
  activitiesPerformed String?
  recommendations     String?
  clientSignedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workOrder      WorkOrder       @relation(fields: [workOrderId], references: [id])
  equipment      Equipment?      @relation(fields: [equipmentId], references: [id])
  checklistItems ChecklistItem[]

  @@index([equipmentId])
  @@map("service_records")
}

// ─── Items del checklist del acta ────────────────────────────────────────────

model ChecklistItem {
  id              String          @id @default(cuid())
  serviceRecordId String
  description     String
  result          ChecklistResult @default(NA)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  serviceRecord ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)

  @@index([serviceRecordId])
  @@map("checklist_items")
}
