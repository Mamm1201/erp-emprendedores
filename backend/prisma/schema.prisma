generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  COMMERCIAL
  TECHNICIAN
  BILLING
}

enum ClientType {
  COMPANY
  PERSON
}

enum DocumentType {
  QUOTATION
  WORK_ORDER
  INVOICE
  MAINTENANCE_CONTRACT
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum WorkOrderStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkOrderType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHECK
  CARD
  OTHER
}

enum ExpenseCategory {
  MATERIALS
  LABOR
  TRANSPORT
  TOOLS
  SUBCONTRACT
  OFFICE
  OTHER
}

// ─── Enums CMMS ───────────────────────────────────────────────────────────────

enum EquipmentType {
  NURSE_CALL
  MEDICAL_ALERT
  GENERATOR
  UPS
  ELECTRICAL
  OTHER
}

enum EquipmentStatus {
  ACTIVE
  INACTIVE
  DECOMMISSIONED
}

enum EquipmentCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MaintenanceFrequency {
  MONTHLY
  QUARTERLY
  EVERY_4_MONTHS
  BIANNUAL
  ANNUAL
}

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum ServiceHoursLevel {
  BUSINESS_HOURS
  EXTENDED
  FULL_TIME
}

enum MaintenanceVisitStatus {
  PENDING
  GENERATED
  COMPLETED
  CANCELLED
}

enum ChecklistResult {
  OK
  WARNING
  FAIL
  NA
}

enum ResourceCategory {
  MATERIAL
  LABOR
  EXPENSE
}

enum ResourceOrigin {
  PLANNED
  ADDITIONAL
}

enum BillingPreparationStatus {
  DRAFT
  CONFIRMED
}

enum BillingResolution {
  CHARGE
  ABSORB
}

enum BillingResolutionSource {
  RULE
  DISCRETIONARY
}

// ─── Retenciones (RETE FUENTE / RETE ICA) — dominio independiente de IVA ──────

enum RetentionConcept {
  RETE_FUENTE
  RETE_ICA
}

// ─── Secuencias comerciales ──────────────────────────────────────────────────

model DocumentSequence {
  id        String       @id @default(cuid())
  docType   DocumentType
  year      Int
  lastValue Int          @default(0)

  @@unique([docType, year])
  @@map("document_sequences")
}

// ─── Usuarios ─────────────────────────────────────────────────────────────────

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  passwordHash     String
  refreshTokenHash String?
  role             UserRole @default(COMMERCIAL)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  quotationsCreated  Quotation[]           @relation("QuotationCreatedBy")
  quotationsUpdated  Quotation[]           @relation("QuotationUpdatedBy")
  workOrdersCreated  WorkOrder[]           @relation("WorkOrderCreatedBy")
  workOrdersUpdated  WorkOrder[]           @relation("WorkOrderUpdatedBy")
  workOrdersAssigned WorkOrder[]           @relation("WorkOrderAssignedTo")
  workOrdersExecuted WorkOrderTechnician[] @relation("WorkOrderTechnician")
  invoicesCreated    Invoice[]             @relation("InvoiceCreatedBy")
  paymentsCreated    Payment[]             @relation("PaymentCreatedBy")
  expensesCreated    Expense[]             @relation("ExpenseCreatedBy")
  fileAttachments    FileAttachment[]
  documentShares     DocumentShare[]
  interventionsAsPrimaryTechnician Intervention[] @relation("InterventionPrimaryTechnician")
  contractsSigned    MaintenanceContract[] @relation("ContractSignedBy")
  resourceUtilizations ResourceUtilization[] @relation("ResourceUtilizationCreatedBy")
  billingPreparationsCreated   BillingPreparation[] @relation("BillingPreparationCreatedBy")
  billingPreparationsConfirmed BillingPreparation[] @relation("BillingPreparationConfirmedBy")
  // CRM de Prospeccion (Fase 1) — relaciones inversas virtuales, sin columna
  // nueva ni cambio de comportamiento en User (Contrato de Diseño Fase 0,
  // decision F0-D01).
  accountsOwned                Account[]             @relation("AccountOwner")
  opportunitiesOwned           Opportunity[]         @relation("OpportunityOwner")
  activitiesCreated            Activity[]            @relation("ActivityCreatedBy")

  @@map("users")
}

// ─── Maestros ────────────────────────────────────────────────────────────────

model Client {
  id        String     @id @default(cuid())
  type      ClientType @default(COMPANY)
  legalName String
  tradeName String?
  taxId     String?    @unique
  email     String?
  phone     String?
  notes     String?
  isIncomeTaxRetentionAgent Boolean @default(false)
  isIcaRetentionAgent       Boolean @default(false)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  branches             Branch[]
  quotations           Quotation[]
  workOrders           WorkOrder[]
  invoices             Invoice[]
  maintenanceContracts MaintenanceContract[]
  // Relacion inversa virtual — la FK (promotedClientId) vive en Account, no
  // aqui. Sin columna nueva ni cambio de comportamiento en Client (Contrato
  // de Diseño Fase 0, decision F0-D01).
  account              Account?

  @@index([legalName])
  @@map("clients")
}

model Branch {
  id           String    @id @default(cuid())
  clientId     String
  name         String
  contactName  String?
  contactPhone String?
  email        String?
  address      String?
  city         String?
  department   String?
  notes        String?
  isPrimary    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client     Client      @relation(fields: [clientId], references: [id])
  quotations Quotation[]
  workOrders WorkOrder[]
  equipment  Equipment[]
  // Relacion inversa virtual — la FK (branchId) vive en Contact, no aqui.
  // Sin columna nueva ni cambio de comportamiento en Branch (Contrato de
  // Diseño Fase 0, decision F0-D01).
  contacts   Contact[]

  @@index([clientId])
  @@index([clientId, name])
  @@map("branches")
}

// ─── Cotización ──────────────────────────────────────────────────────────────

model Quotation {
  id                  String          @id @default(cuid())
  number              String          @unique
  clientId            String
  branchId            String?
  status              QuotationStatus @default(DRAFT)
  issueDate           DateTime        @default(now()) @db.Date
  validUntil          DateTime?       @db.Date
  notes               String?
  terms               String?
  subtotal            Decimal         @default(0) @db.Decimal(12, 2)
  discountTotal       Decimal         @default(0) @db.Decimal(12, 2)
  taxTotal            Decimal         @default(0) @db.Decimal(12, 2)
  total               Decimal         @default(0) @db.Decimal(12, 2)
  retentionsApplied   Boolean         @default(false)
  clientLegalName     String?
  clientTaxId         String?
  branchName          String?
  branchAddress       String?
  branchCity          String?
  branchDepartment    String?
  branchContactName   String?
  branchContactPhone  String?
  snapshotAt          DateTime?
  sentAt              DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  cancelledAt         DateTime?
  rejectionNotes      String?         @db.VarChar(1000)
  cancellationNotes   String?         @db.VarChar(500)
  createdById         String?
  updatedById         String?
  // CRM de Prospeccion (Fase 1): vincula esta cotizacion a la Opportunity
  // que la origino. Nullable/aditivo — cotizaciones sin Opportunity de
  // origen (flujo actual) siguen funcionando exactamente igual. No cambia
  // la semantica de clientId ni de ningun otro campo existente.
  opportunityId       String?
  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  client              Client              @relation(fields: [clientId], references: [id])
  branch              Branch?             @relation(fields: [branchId], references: [id])
  opportunity         Opportunity?        @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  workOrder           WorkOrder?
  maintenanceContract MaintenanceContract?
  items               QuotationItem[]
  retentionLines      QuotationRetentionLine[]
  createdBy           User?               @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  updatedBy           User?               @relation("QuotationUpdatedBy", fields: [updatedById], references: [id])

  @@index([clientId, status])
  @@index([issueDate])
  @@index([opportunityId])
  @@map("quotations")
}

model QuotationItem {
  id             String   @id @default(cuid())
  quotationId    String
  lineOrder      Int      @default(0)
  description    String
  quantity       Decimal  @db.Decimal(12, 3)
  unitPrice      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  lineSubtotal   Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

// Líneas de retención estimadas de la cotización. Snapshot de RetentionRate en
// el momento del cálculo — no referencia viva. Se recrea en cada guardado
// mientras la cotización está en DRAFT; se congela definitivamente al pasar a
// SENT (junto con clientLegalName/branchCity en buildCommercialSnapshotData).
model QuotationRetentionLine {
  id                        String            @id @default(cuid())
  quotationId               String
  concept                   RetentionConcept
  municipalityCodeSnapshot  String?
  taxpayerConditionSnapshot String?
  rateSnapshot              Decimal?          @db.Decimal(5, 3)
  rateMinSnapshot           Decimal?          @db.Decimal(5, 3)
  rateMaxSnapshot           Decimal?          @db.Decimal(5, 3)
  legalSourceSnapshot       String
  estimatedAmount           Decimal?          @db.Decimal(12, 2)
  estimatedAmountMin        Decimal?          @db.Decimal(12, 2)
  estimatedAmountMax        Decimal?          @db.Decimal(12, 2)
  createdAt                 DateTime          @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_retention_lines")
}

// Configuración de tarifas de retención (RETE FUENTE / RETE ICA). Tabla de
// configuración pura, sin FK hacia Quotation — se consulta por fecha vigente y
// se copia (snapshot) a QuotationRetentionLine, nunca se referencia en vivo
// desde un documento ya generado. Ningún porcentaje se codifica en la
// aplicación; toda tarifa debe existir aquí con su fuente normativa.
// municipalityCode = código DIVIPOLA (DANE); null cuando concept=RETE_FUENTE
// (retención nacional), obligatorio cuando concept=RETE_ICA (municipal).
// rate = tarifa puntual; rateMin/rateMax = rango cuando la norma no permite
// fijar un único valor. Uno u otro, nunca ambos (invariante en CHECK de BD).
model RetentionRate {
  id                    String            @id @default(cuid())
  concept               RetentionConcept
  municipalityCode      String?
  taxpayerConditionNote String?
  rate                  Decimal?          @db.Decimal(5, 3)
  rateMin               Decimal?          @db.Decimal(5, 3)
  rateMax               Decimal?          @db.Decimal(5, 3)
  minimumBaseUvt        Decimal?          @db.Decimal(6, 2)
  uvtValueSnapshot      Decimal?          @db.Decimal(10, 2)
  legalSource           String
  effectiveFrom         DateTime          @db.Date
  effectiveTo           DateTime?         @db.Date
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([concept, municipalityCode])
  @@map("retention_rates")
}

// Alias de resolución ciudad (Branch.city, texto libre) → código DIVIPOLA
// (DANE). Uso exclusivamente interno del backend — el DIVIPOLA nunca se
// serializa hacia el frontend; GET /retention-rates devuelve `cityLabel` ya
// resuelto en su lugar. Agregar una ciudad nueva es una fila aquí + una fila
// en RetentionRate, sin migración ni redeploy.
model MunicipalityAlias {
  id           String   @id @default(cuid())
  cityLabel    String   @unique
  divipolaCode String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("municipality_aliases")
}

// ─── Orden de trabajo ────────────────────────────────────────────────────────

model WorkOrder {
  id            String          @id @default(cuid())
  number        String          @unique
  clientId      String
  branchId      String?
  quotationId   String?         @unique
  type          WorkOrderType   @default(CORRECTIVE)
  status        WorkOrderStatus @default(DRAFT)
  title         String
  description   String?
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  subtotal      Decimal         @default(0) @db.Decimal(12, 2)
  discountTotal Decimal         @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal         @default(0) @db.Decimal(12, 2)
  total         Decimal         @default(0) @db.Decimal(12, 2)
  equipmentId   String?
  assignedToId  String?
  createdById   String?
  updatedById   String?
  // Firma de conformidad del Acta — hito de ciclo de vida de la OT, misma
  // naturaleza que scheduledAt/startedAt/completedAt. Reemplaza a
  // ServiceRecord.clientSignedAt (ver Intervention mas abajo).
  clientSignedAt DateTime?
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  client           Client            @relation(fields: [clientId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id])
  quotation        Quotation?        @relation(fields: [quotationId], references: [id])
  equipment        Equipment?        @relation(fields: [equipmentId], references: [id])
  items                WorkOrderItem[]
  resourceUtilizations ResourceUtilization[]
  billingPreparation   BillingPreparation?
  invoice          Invoice?
  expenses         Expense[]
  assignedTo       User?             @relation("WorkOrderAssignedTo", fields: [assignedToId], references: [id])
  createdBy        User?             @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?             @relation("WorkOrderUpdatedBy", fields: [updatedById], references: [id])
  serviceRecord    ServiceRecord?
  maintenanceVisit MaintenanceVisit?
  technicians      WorkOrderTechnician[]
  interventions    Intervention[]

  @@index([clientId, status])
  @@index([assignedToId])
  @@index([completedAt])
  @@index([equipmentId])
  @@map("work_orders")
}

// ─── Ejecutores de la OT (contexto Operaciones) ────────────────────────────────
// La OT es la fuente de verdad de la ejecución. Registra quién ejecutó
// realmente la intervención — distinto de `WorkOrder.assignedToId`
// (responsable/asignado en planeación). El Acta Técnica y su PDF son evidencia
// derivada: leen esta relación, nunca la almacenan de forma independiente.

model WorkOrderTechnician {
  id          String   @id @default(cuid())
  workOrderId String
  userId      String
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkOrderTechnician", fields: [userId], references: [id])

  @@unique([workOrderId, userId])
  @@index([workOrderId])
  @@index([userId])
  @@map("work_order_technicians")
}

model WorkOrderItem {
  id             String   @id @default(cuid())
  workOrderId    String
  lineOrder      Int      @default(0)
  description    String
  quantity       Decimal  @db.Decimal(12, 3)
  unitPrice      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  lineSubtotal   Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("work_order_items")
}

// ─── Utilización de recurso (OT-8 — contexto Operaciones) ─────────────────────
// Entity local del agregado WorkOrder. Registra el hecho técnico de haber usado
// un recurso durante la intervención. SIN economía (RFC-06 / modelo Operaciones).
// Invariantes: pertenece a una única OT, no existe sin OT, y se congela con la OT
// al pasar a COMPLETED/CANCELLED. Recurso hoy inline (texto); catálogo diferido.

model ResourceUtilization {
  id           String           @id @default(cuid())
  workOrderId  String
  resourceName String
  category     ResourceCategory
  quantity     Decimal          @db.Decimal(12, 3)
  unit         String
  origin       ResourceOrigin
  observation  String?
  createdById  String
  createdAt    DateTime         @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ResourceUtilizationCreatedBy", fields: [createdById], references: [id])
  billingLineResolutions BillingLineResolution[]

  @@index([workOrderId])
  @@map("resource_utilizations")
}

// ─── Preparación de Facturación (contexto Facturación · RFC-06) ────────────────
// Aggregate Root: decide, por cada elemento ejecutado (Utilización), su resolución
// económica. Consume disposiciones regladas (futuro) y decide el residual. El
// RESULTADO NO se persiste — se deriva de las resoluciones; el snapshot fiscal lo
// conserva el documento al emitirse. Sin lógica reglada aquí (invariante no-apropiación).

model BillingPreparation {
  id            String                   @id @default(cuid())
  workOrderId   String                   @unique
  status        BillingPreparationStatus @default(DRAFT)
  notes         String?
  createdById   String
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  confirmedById String?
  confirmedAt   DateTime?

  workOrder   WorkOrder               @relation(fields: [workOrderId], references: [id])
  createdBy   User                    @relation("BillingPreparationCreatedBy", fields: [createdById], references: [id])
  confirmedBy User?                   @relation("BillingPreparationConfirmedBy", fields: [confirmedById], references: [id])
  resolutions BillingLineResolution[]
  invoice     Invoice?

  @@map("billing_preparations")
}

// Value Object del agregado (persistido como fila hija): la resolución económica de
// UN elemento ejecutado. Guarda los INSUMOS de la decisión (cantidad, precio,
// descuento, impuesto); los totales de línea y el total se DERIVAN, no se guardan.
model BillingLineResolution {
  id                   String                  @id @default(cuid())
  billingPreparationId String
  utilizationId        String
  resolution           BillingResolution
  source               BillingResolutionSource @default(DISCRETIONARY)
  billableQuantity     Decimal?                @db.Decimal(12, 3)
  unitPrice            Decimal?                @db.Decimal(12, 2)
  discountAmount       Decimal                 @default(0) @db.Decimal(12, 2)
  taxRate              Decimal                 @default(0) @db.Decimal(5, 2)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  preparation BillingPreparation  @relation(fields: [billingPreparationId], references: [id], onDelete: Cascade)
  utilization ResourceUtilization @relation(fields: [utilizationId], references: [id])

  @@unique([billingPreparationId, utilizationId])
  @@index([billingPreparationId])
  @@map("billing_line_resolutions")
}

// ─── Cuenta de cobro ─────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  workOrderId   String?       @unique
  contractId    String?
  preparationId String?       @unique
  clientId      String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now()) @db.Date
  dueDate       DateTime      @db.Date
  notes         String?
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  voidedAt      DateTime?
  voidReason    String?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workOrder   WorkOrder?           @relation(fields: [workOrderId], references: [id])
  contract    MaintenanceContract? @relation(fields: [contractId], references: [id])
  preparation BillingPreparation?  @relation(fields: [preparationId], references: [id])
  client      Client               @relation(fields: [clientId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]
  createdBy   User?                @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  @@index([clientId, status])
  @@index([contractId])
  @@index([dueDate])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  lineOrder      Int      @default(0)
  description    String
  quantity       Decimal  @db.Decimal(12, 3)
  unitPrice      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  lineSubtotal   Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ─── Pagos y gastos ──────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  amount      Decimal       @db.Decimal(12, 2)
  paidAt      DateTime      @default(now())
  method      PaymentMethod @default(TRANSFER)
  reference   String?
  notes       String?
  voidedAt    DateTime?
  voidReason  String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  createdBy User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([invoiceId])
  @@index([paidAt])
  @@map("payments")
}

model Expense {
  id          String          @id @default(cuid())
  workOrderId String?
  category    ExpenseCategory @default(OTHER)
  description String
  amount      Decimal         @db.Decimal(12, 2)
  expenseDate DateTime        @default(now()) @db.Date
  vendorName  String?
  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])
  createdBy User?      @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([workOrderId])
  @@index([expenseDate])
  @@index([category])
  @@index([deletedAt])
  @@map("expenses")
}

// ─── Hoja de vida del equipo ──────────────────────────────────────────────────

model Equipment {
  id                String               @id @default(cuid())
  branchId          String
  type              EquipmentType
  brand             String?
  model             String?
  serialNumber      String?
  installDate       DateTime?            @db.Date
  location          String?
  notes             String?
  status            EquipmentStatus      @default(ACTIVE)
  criticality       EquipmentCriticality @default(MEDIUM)
  warrantyExpiresAt DateTime?            @db.Date
  qrCode            String?              @unique
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  branch            Branch                    @relation(fields: [branchId], references: [id])
  workOrders        WorkOrder[]
  contractEquipment ContractEquipment[]
  planEquipment     MaintenancePlanEquipment[]
  interventions     Intervention[]

  @@index([branchId])
  @@index([type])
  @@index([criticality])
  @@index([qrCode])
  @@map("equipment")
}

// ─── Contratos de mantenimiento ───────────────────────────────────────────────

model MaintenanceContract {
  id                 String         @id @default(cuid())
  number             String         @unique
  clientId           String
  status             ContractStatus @default(DRAFT)
  billingCycle       BillingCycle
  value              Decimal        @db.Decimal(12, 2)
  startDate          DateTime       @db.Date
  endDate            DateTime       @db.Date
  signedAt           DateTime?
  signedById         String?
  quotationId        String?        @unique
  correctiveIncluded Boolean        @default(false)
  partsIncluded      Boolean        @default(false)
  transportIncluded  Boolean        @default(false)
  serviceHours       ServiceHoursLevel @default(BUSINESS_HOURS)
  slaHoursCritical   Int?
  slaHoursHigh       Int?
  slaHoursMedium     Int?
  slaHoursLow        Int?
  notes              String?
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  client            Client              @relation(fields: [clientId], references: [id])
  signedBy          User?               @relation("ContractSignedBy", fields: [signedById], references: [id])
  quotation         Quotation?          @relation(fields: [quotationId], references: [id])
  contractEquipment ContractEquipment[]
  maintenancePlans  MaintenancePlan[]
  invoices          Invoice[]

  @@index([clientId, status])
  @@index([endDate])
  @@map("maintenance_contracts")
}

model ContractEquipment {
  id          String   @id @default(cuid())
  contractId  String
  equipmentId String
  addedAt     DateTime @default(now())
  notes       String?

  contract  MaintenanceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  equipment Equipment           @relation(fields: [equipmentId], references: [id])

  @@unique([contractId, equipmentId])
  @@index([equipmentId])
  @@map("contract_equipment")
}

// ─── Plan de mantenimiento preventivo ────────────────────────────────────────

model MaintenancePlan {
  id          String               @id @default(cuid())
  contractId  String
  frequency   MaintenanceFrequency
  startDate   DateTime             @db.Date
  isActive    Boolean              @default(true)
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  contract      MaintenanceContract       @relation(fields: [contractId], references: [id])
  visits        MaintenanceVisit[]
  planEquipment MaintenancePlanEquipment[]

  @@index([contractId])
  @@index([isActive])
  @@map("maintenance_plans")
}

model MaintenancePlanEquipment {
  id          String   @id @default(cuid())
  planId      String
  equipmentId String
  addedAt     DateTime @default(now())
  notes       String?

  plan      MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  equipment Equipment       @relation(fields: [equipmentId], references: [id])

  @@unique([planId, equipmentId])
  @@index([equipmentId])
  @@map("maintenance_plan_equipment")
}

// ─── Visitas de mantenimiento ─────────────────────────────────────────────────

model MaintenanceVisit {
  id            String                 @id @default(cuid())
  planId        String
  scheduledDate DateTime               @db.Date
  windowEnd     DateTime?              @db.Date
  status        MaintenanceVisitStatus @default(PENDING)
  workOrderId   String?                @unique
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  plan      MaintenancePlan @relation(fields: [planId], references: [id])
  workOrder WorkOrder?      @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([planId, scheduledDate])
  @@index([status, scheduledDate])
  @@map("maintenance_visits")
}

// ─── Acta técnica de la visita ────────────────────────────────────────────────

model ServiceRecord {
  id                  String    @id @default(cuid())
  workOrderId         String    @unique
  findings            String?
  activitiesPerformed String?
  recommendations     String?
  clientSignedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workOrder      WorkOrder       @relation(fields: [workOrderId], references: [id])
  checklistItems ChecklistItem[]

  @@map("service_records")
}

// ─── Items del checklist del acta ────────────────────────────────────────────

model ChecklistItem {
  id              String          @id @default(cuid())
  serviceRecordId String
  description     String
  result          ChecklistResult @default(NA)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  // Migracion hacia Intervention (aditivo): serviceRecordId se conserva sin
  // cambios; interventionId es el nuevo destino, nullable mientras convive
  // con ServiceRecord durante la transicion.
  interventionId  String?

  serviceRecord ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)
  intervention  Intervention? @relation(fields: [interventionId], references: [id])

  @@index([serviceRecordId])
  @@index([interventionId])
  @@map("checklist_items")
}

// ─── Gestión de evidencias / adjuntos ────────────────────────────────────────

enum FileEntityType {
  EQUIPMENT
  WORK_ORDER
  SERVICE_RECORD
  CLIENT
  QUOTATION
  INVOICE
  INTERVENTION
}

enum FileCategory {
  PHOTO
  DOCUMENT
  CERTIFICATE
  MANUAL
}

model FileAttachment {
  id           String         @id @default(cuid())
  entityType   FileEntityType
  entityId     String
  category     FileCategory
  originalName String
  storagePath  String
  mimeType     String
  sizeBytes    Int
  description  String?        @db.VarChar(500)
  takenAt      DateTime?
  uploadedById String
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())

  @@index([entityType, entityId])
  @@map("file_attachments")
}

// ─── Enlaces públicos de documentos compartidos ────────────────────────────────
// Snapshot inmutable del PDF al momento de compartir. El endpoint público solo
// lee storagePath — nunca vuelve a consultar el documento origen, por lo que un
// share ya emitido nunca cambia aunque el origen se modifique, cambie de estado
// o se elimine logicamente despues.

enum DocumentShareType {
  QUOTATION
  INVOICE
  SERVICE_RECORD
}

model DocumentShare {
  id             String            @id @default(cuid())
  token          String            @unique
  type           DocumentShareType
  sourceId       String
  sourceNumber   String
  storagePath    String
  mimeType       String            @default("application/pdf")
  sizeBytes      Int
  createdById    String
  createdAt      DateTime          @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  lastAccessedAt DateTime?
  accessCount    Int               @default(0)

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([type, sourceId])
  @@map("document_shares")
}

// ─── Trazabilidad por activo ────────────────────────────────────────────────
// Intervention = registro tecnico de una intervencion concreta sobre UN
// Equipment. WorkOrder es el contenedor administrativo/comercial (1..N
// Intervention). equipmentId es obligatorio: es la garantia central de que
// ninguna intervencion tecnica queda sin activo asociado.

enum InterventionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Intervention {
  id                         String              @id @default(cuid())
  workOrderId                 String
  equipmentId                 String
  type                        WorkOrderType
  status                       InterventionStatus @default(IN_PROGRESS)
  findings                    String?
  activitiesPerformed          String?
  recommendations             String?
  occurredAt                  DateTime?
  primaryTechnicianId          String?
  // Auditoria de migracion: solo poblado en Intervention creadas por la
  // migracion automatica desde ServiceRecord — null para las nativas.
  migratedFromServiceRecordId  String?            @unique
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  workOrder         WorkOrder       @relation(fields: [workOrderId], references: [id])
  equipment          Equipment       @relation(fields: [equipmentId], references: [id])
  primaryTechnician   User?           @relation("InterventionPrimaryTechnician", fields: [primaryTechnicianId], references: [id])
  checklistItems     ChecklistItem[]

  @@index([workOrderId])
  @@index([equipmentId])
  @@map("interventions")
}

// Bitacora de auditoria de la migracion ServiceRecord → Intervention.
// Permanente: permite reconstruir, para cualquier dato migrado, exactamente
// de donde vino y que registro nuevo lo representa.
model MigrationLog {
  id          String   @id @default(cuid())
  operation   String
  sourceTable String
  sourceId    String
  targetTable String
  targetId    String
  detail      Json?
  migratedAt  DateTime @default(now())

  @@index([sourceTable, sourceId])
  @@index([targetTable, targetId])
  @@map("migration_log")
}

// ─── CRM de Prospección Comercial (Fase 1) ─────────────────────────────────────
// Contrato de Diseño Fase 0 (2026-08-31): Account → Contact → Opportunity →
// Activity, separado de Client (entidad financiera critica) a proposito.
// Account se conecta a Client mediante promotedClientId cuando se genera la
// primera Quotation desde una Opportunity — Client existente no implica
// negocio ganado; WON depende exclusivamente de Quotation.status = APPROVED.

enum LeadSource {
  LINKEDIN
  REFERRAL
  INBOUND
  EVENT
  OTHER
}

// Tipo y tamaño de institucion — no estaban enumerados explicitamente en el
// Contrato de Diseño (solo se aprobaron los campos institutionType y
// sizePotential); se definen como enum aqui, consistente con el resto del
// schema, no como String libre.
enum InstitutionType {
  IPS
  CLINIC
  HOSPITAL
  OTHER
}

enum SizePotential {
  SMALL
  MEDIUM
  LARGE
}

enum AccountStatus {
  ACTIVE_PROSPECT
  CUSTOMER
  DORMANT
  DISQUALIFIED
}

// Cuenta objetivo (empresa/IPS) durante la etapa de prospeccion.
model Account {
  id               String          @id @default(cuid())
  legalName        String
  nit              String?
  city             String
  institutionType  InstitutionType
  sizePotential    SizePotential?
  website          String?
  status           AccountStatus   @default(ACTIVE_PROSPECT)
  source           LeadSource
  notes            String?
  ownerId          String
  promotedClientId String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  owner         User          @relation("AccountOwner", fields: [ownerId], references: [id])
  client        Client?       @relation(fields: [promotedClientId], references: [id])
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]

  @@index([legalName])
  @@index([status])
  @@index([ownerId])
  @@map("accounts")
}

enum ContactRole {
  IPS_MANAGER
  ADMIN_DIRECTOR
  INFRASTRUCTURE_DIRECTOR
  MAINTENANCE_COORDINATOR
  HOSPITAL_ENGINEERING
  BIOMEDICAL_MANAGER
  PROCUREMENT
  QUALITY_COMPLIANCE
  OTHER
}

enum InfluenceLevel {
  DECISION_MAKER
  INFLUENCER
  GATEKEEPER
  UNKNOWN
}

// Persona decisora/influenciadora en una Account — distinto de
// Branch.contactName / Quotation.branchContactName (contacto operativo de
// sitio para logistica de OT). Responsabilidades diferentes, no se unifican.
model Contact {
  id             String         @id @default(cuid())
  accountId      String
  branchId       String?
  name           String
  role           ContactRole
  area           String?
  linkedinUrl    String?
  email          String?
  phone          String?
  influenceLevel InfluenceLevel @default(UNKNOWN)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  branch        Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  opportunities Opportunity[] @relation("OpportunityPrimaryContact")
  activities    Activity[]

  @@index([accountId])
  @@index([branchId])
  @@map("contacts")
}

enum OpportunityStage {
  IDENTIFIED
  RESEARCHING
  CONTACTED
  CONVERSING
  MEETING_DIAGNOSIS
  QUOTED
  NEGOTIATING
  WON
  LOST
}

enum OpportunityPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Oportunidad comercial dentro de una Account. WON es una transicion
// exclusivamente automatica (nunca manual), gobernada por el estado de la(s)
// Quotation(s) vinculada(s) — ver Contrato de Diseño Fase 0, regla de
// promocion y tabla de transiciones. nextActionAt/lastContactedAt NO existen
// como campos: se derivan del historial de Activity.
model Opportunity {
  id               String              @id @default(cuid())
  accountId        String
  primaryContactId String?
  title            String
  detectedNeed     String?
  score            Int                 @default(0)
  priority         OpportunityPriority @default(MEDIUM)
  stage            OpportunityStage    @default(IDENTIFIED)
  source           LeadSource
  probability      Int?
  potentialValue   Decimal?            @db.Decimal(12, 2)
  notes            String?
  ownerId          String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  account        Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  primaryContact Contact?    @relation("OpportunityPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  owner          User        @relation("OpportunityOwner", fields: [ownerId], references: [id])
  activities     Activity[]
  quotations     Quotation[]
  services       Service[]

  @@index([accountId])
  @@index([stage])
  @@index([ownerId])
  @@map("opportunities")
}

enum ActivityType {
  LINKEDIN
  EMAIL
  WHATSAPP
  CALL
  MEETING
  NOTE
  PROPOSAL
  FOLLOW_UP
}

enum ActivityStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

// Registro de interaccion comercial — fuente de verdad de "ultimo contacto" y
// "proxima accion" (derivados por consulta, no campos sueltos en Opportunity).
// accountId siempre obligatorio; opportunityId/contactId opcionales — permite
// registrar actividad desde la etapa inicial de prospeccion, antes de que
// exista una Opportunity formal.
model Activity {
  id            String         @id @default(cuid())
  accountId     String
  opportunityId String?
  contactId     String?
  type          ActivityType
  status        ActivityStatus @default(COMPLETED)
  occurredAt    DateTime
  summary       String
  outcome       String?
  aiGenerated   Boolean        @default(false)
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("ActivityCreatedBy", fields: [createdById], references: [id])

  @@index([accountId])
  @@index([opportunityId])
  @@index([status])
  @@map("activities")
}

// Catalogo editable de servicios comerciales de STECH NODES — deliberadamente
// NO EquipmentType (enum operativo: no cubre mobiliario ni biomedico via
// integrador). Sembrado inicial: los 3 bloques vigentes del sitio (ver
// Contrato de Diseño Fase 0). Relacion N:M implicita con Opportunity — sin
// modelo de union explicito, sin atributos propios de la relacion.
model Service {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  opportunities Opportunity[]

  @@map("services")
}
