# Copiar a .env y ajustar si cambias las credenciales de Docker Compose

# ─── Base de datos ────────────────────────────────────────────────────────────
# Debe coincidir con POSTGRES_* del .env en la raíz del proyecto
DATABASE_URL="postgresql://erp_user:erp_dev_password@localhost:5433/erp_emprendedores?schema=public"

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# ─── JWT — Access Token ───────────────────────────────────────────────────────
# Secreto largo y aleatorio (mínimo 32 caracteres). Nunca compartir ni commitear.
JWT_SECRET="CAMBIAR_POR_SECRETO_SEGURO_MINIMO_32_CHARS"
# Tiempo de vida del access token. Ejemplos: 15m, 1h, 30m
JWT_EXPIRES_IN="15m"

# ─── JWT — Refresh Token ──────────────────────────────────────────────────────
# Secreto diferente al del access token.
JWT_REFRESH_SECRET="CAMBIAR_POR_OTRO_SECRETO_SEGURO_MINIMO_32_CHARS"
# Tiempo de vida del refresh token. Ejemplos: 7d, 30d
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Cookie (Refresh Token) ───────────────────────────────────────────────────
# COOKIE_SECURE: false en desarrollo (HTTP), true en producción (HTTPS)
COOKIE_SECURE=false
# COOKIE_DOMAIN: vacío en desarrollo local. En producción: tu dominio (ej: erp.stechnodes.com)
COOKIE_DOMAIN=
# COOKIE_SAME_SITE: lax (recomendado para apps SPA). Opciones: strict | lax | none
COOKIE_SAME_SITE=lax
