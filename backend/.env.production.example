# ─── ERP Backend — Variables de producción ────────────────────────────────────
# Copia este archivo como .env en el servidor de producción.
# NUNCA commitear el .env real. Este archivo documenta las variables requeridas.

# ── Base de datos ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:password@host:5432/erp_emprendedores"

# ── JWT ────────────────────────────────────────────────────────────────────────
# Nombres exactos que lee el código (auth.service.ts, getOrThrow) — si no
# coinciden letra por letra el backend lanza excepcion en el primer
# login/refresh.
JWT_SECRET="cambia-esto-por-un-secreto-seguro-minimo-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-seguro-minimo-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Cookie (Refresh Token) ──────────────────────────────────────────────────────
# CRÍTICO: si se omite COOKIE_SECURE, el código usa `false` por defecto — la
# cookie de refresh se enviaria SIN el flag Secure incluso en HTTPS.
COOKIE_SECURE=true
# Dominio de la cookie en producción (ej: erp.stechnodes.com). Vacío = host actual.
COOKIE_DOMAIN=""
# lax (recomendado para SPA propia) | strict | none
COOKIE_SAME_SITE=lax

# ── CORS ───────────────────────────────────────────────────────────────────────
# Origen del ERP frontend (sin trailing slash)
CORS_ORIGIN="https://erp.stechnodes.com"

# Origen del portal QR público (sin trailing slash)
# CRÍTICO: debe coincidir exactamente con la URL donde corre qr-portal/ en producción
PORTAL_ORIGIN="https://portal.stechnodes.com"

# ── Almacenamiento ────────────────────────────────────────────────────────────
UPLOAD_DIR="/var/data/uploads"

# ── Puerto ────────────────────────────────────────────────────────────────────
PORT=3000

# ─── CHECKLIST DE PRODUCCIÓN ──────────────────────────────────────────────────
# Antes de generar los primeros QR físicos verificar:
# [ ] CORS_ORIGIN apunta al ERP real (no localhost)
# [ ] PORTAL_ORIGIN apunta al portal real (no localhost)
# [ ] DATABASE_URL apunta a la base de datos de producción
# [ ] JWT_SECRET y JWT_REFRESH_SECRET son valores únicos y seguros
# [ ] JWT_EXPIRES_IN y JWT_REFRESH_EXPIRES_IN están definidas con esos nombres exactos
# [ ] COOKIE_SECURE=true (el backend responde en HTTPS, no HTTP)
